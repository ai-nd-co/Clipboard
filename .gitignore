# --- Build and packaging output ---------------------------------------
# Produced by `gnome-extensions pack`; rebuilt from source on every release.
*.shell-extension.zip
build/
dist/

# Compiled GSettings schema. Generated by `glib-compile-schemas` on install,
# and by extensions.gnome.org on upload, so it must never be committed.
schemas/gschemas.compiled

# --- Translations ------------------------------------------------------
# The .po sources and the .pot template are tracked; the compiled catalogues
# that `gnome-extensions pack --podir` generates are not.
po/*.mo
po/*.po~
locale/

# --- Editors and IDEs --------------------------------------------------
*.bak
*.orig
*.rej
*~
*.swp
*.swo
.*.sw?
.vscode/
.idea/
*.sublime-workspace

# --- Operating system --------------------------------------------------
.DS_Store
._*
.directory
.Trash-*
Thumbs.db
desktop.ini

# --- Tooling -----------------------------------------------------------
# Only present if you add an ESLint setup, which the GNOME extension
# guidelines recommend but this project does not currently ship.
node_modules/
*.log
